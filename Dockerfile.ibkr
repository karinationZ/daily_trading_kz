# ---------------------------------------------------------------------------
# Stage 1: Source IB Gateway & IBC
# ---------------------------------------------------------------------------
FROM ghcr.io/gnzsnz/ib-gateway:stable AS ibkr_source

# ---------------------------------------------------------------------------
# Stage 2: Final Image
# ---------------------------------------------------------------------------
FROM python:3.11-slim

# --- 1. Install System Dependencies ---
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    # Build & Core Tools
    make \
    curl \
    unzip \
    procps \
    sudo \
    gettext-base \
    # Networking & Remote Access
    socat \
    sshpass \
    openssh-client \
    netcat-openbsd \
    # Display Server (Critical for IB Gateway)
    xvfb \
    x11vnc \
    # Minimal Java GUI Dependencies (Required for IB Gateway to draw windows)
    libxext6 \
    libxrender1 \
    libxtst6 \
    libxi6 \
    libfreetype6 \
    # Process Manager
    supervisor \
    && rm -rf /var/lib/apt/lists/*

# --- 2. Setup IB Gateway Environment ---

ARG USER_ID=1000
ARG USER_GID=1000

# Create ibgateway user
RUN groupadd --gid ${USER_GID} ibgateway && \
    useradd -ms /bin/bash --uid ${USER_ID} --gid ${USER_GID} ibgateway && \
    echo "ibgateway ALL=(ALL) NOPASSWD:ALL" | tee -a /etc/sudoers

# Environment Variables
ENV HOME=/home/ibgateway
ENV TWS_PATH=${HOME}/Jts
ENV TWS_INI=jts.ini
ENV TWS_INI_TMPL=${TWS_INI}.tmpl
ENV IBC_PATH=${HOME}/ibc
ENV IBC_INI=${HOME}/ibc/config.ini
ENV IBC_INI_TMPL=${IBC_INI}.tmpl
ENV SCRIPT_PATH=${HOME}/scripts
ENV GATEWAY_OR_TWS=gateway

# --- COPY FILES ---
COPY --from=ibkr_source /usr/local /usr/local
COPY --from=ibkr_source --chown=${USER_ID}:${USER_GID} /home/ibgateway/ /home/ibgateway/

# Ensure scripts represent the correct permissions
RUN chmod a+x ${SCRIPT_PATH}/*.sh

# --- 3. Setup Python Bot Environment ---

RUN pip install --no-cache-dir poetry

WORKDIR /app

COPY pyproject.toml poetry.lock Makefile ./
COPY . .

RUN poetry config virtualenvs.create false && poetry install --only main --no-interaction --no-ansi

COPY supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# --- 4. Final Configuration ---

ENV MAKE_COMMAND=run_ibkr_bot

USER root

CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]